# Development is isolated from production, even when .env.local contains production credentials.
TURSO_DEVELOPMENT_DATABASE_URL=file:./data/church-development.db
TURSO_DEVELOPMENT_AUTH_TOKEN=
# Set these only in the production deployment (or .env.production.local).
# TURSO_PRODUCTION_DATABASE_URL=libsql://your-production-database.turso.io
# TURSO_PRODUCTION_AUTH_TOKEN=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=gnlkergh
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=deel-assets
# Optional separate unsigned preset permitting audio up to 50 MB.
# NEXT_PUBLIC_CLOUDINARY_AUDIO_UPLOAD_PRESET=
